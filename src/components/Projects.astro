---
import type { Project } from "$/projects";
import ProjectEntry from "./ProjectEntry.astro";

interface Props {
  projects: Project[];
}
const { projects: projects } = Astro.props;
---

<section class="min-h-full min-w-full mt-8">
  <ul class="flex flex-wrap justify-center gap-2">
    {projects.map((project) => <ProjectEntry project={project} />)}
  </ul>
</section>

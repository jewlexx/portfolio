---
import type { Project } from "$/projects";
import { Image } from "astro:assets";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="min-h-full min-w-full">
  <ul class="flex flex-wrap justify-center gap-2">
    <li
      class="card prose bg-base-200/50 card-lg p-5 shadow-sm transition-transform duration-75 hover:z-50 hover:scale-105"
    >
      <a class="no-underline" href={`/projects/${project.slug}`}>
        <Image
          src={project.heroImage!}
          alt={`${project.title} Hero Image`}
          width={1200 / 4}
          height={630 / 4}
          width="1200"
          height="630"
          class="w-300"
        />
        <h1>
          {project.emoji}
          {project.title}
        </h1>
        <i>{project.description}</i>
      </a>
    </li>
  </ul>
</section>

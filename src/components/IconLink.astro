---
import type { Icon } from "@tabler/icons-react";

interface Props {
  title: string;
  prettyTitle?: string;
  url: string;
  icon: Icon;
  local?: boolean;
  disabled?: boolean;
  alt?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  prettyTitle,
  url: originalUrl,
  icon: Icon,
  local = false,
  alt,
  class: className,
  ...rest
} = Astro.props;

function adjustUrl(url: string) {
  // Local url
  if (url.startsWith("/")) {
    return url;
  }

  // External url
  if (!url.startsWith("http")) {
    return `https://${url}`;
  } else {
    return url;
  }
}

const adjustedUrl = adjustUrl(originalUrl);

const linkProps = { ...rest, color: undefined, prettyTitle: undefined };
---

<a
  role="button"
  href={adjustedUrl}
  target={local ? undefined : "_blank"}
  rel={local ? undefined : "noopener noreferrer"}
  class={`btn not-lg:btn-circle! btn-rounded lg:btn-lg m-1 lg:flex lg:justify-between ${className}`}
  {...linkProps}
>
  <Icon title={alt ?? title} />
  <p class="not-lg:hidden">{prettyTitle ?? title}</p>
</a>

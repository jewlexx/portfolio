---
import type { Project } from "$/projects";
import { Image } from "astro:assets";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<li
  class="card bg-base-200/50 card-sm p-5 shadow-sm transition-transform duration-75 hover:z-50 hover:scale-105 w-lg"
>
  <a class="no-underline" href={`/projects/${project.slug}`}>
    <Image
      src={project.heroImage!}
      alt={`${project.title} Hero Image`}
      width={1200 / 4}
      height={630 / 4}
      class="w-full"
    />
    <h1 class="font-extrabold wrap-anywhere">
      {project.emoji}
      {project.title}
    </h1>
    <i class="wrap-anywhere">{project.description}</i>
  </a>
</li>

---
import type { Icon } from "@tabler/icons-react";

interface Props {
  icon: Icon;
  alt: string | undefined;
  title: string;
  adjustedUrl: string;
  class?: string;
  linkProps: Record<string, unknown>;
  local: boolean;
}
const {
  icon: Icon,
  alt,
  title,
  adjustedUrl,
  class: className,
  linkProps,
  local,
} = Astro.props;
---

<a
  role="button"
  href={adjustedUrl}
  target={local ? undefined : "_blank"}
  rel={local ? undefined : "noopener noreferrer"}
  class={`btn not-lg:btn-circle! btn-rounded lg:btn-lg m-1 lg:flex lg:justify-between ${className}`}
  {...linkProps}
>
  <Icon title={alt ?? title} />
  <p class="not-lg:hidden">{title}</p>
</a>

---
import { IoIosArrowDropdown } from "react-icons/io";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div id="container" x-data="{ expanded: false }">
  <h3 class="flex cursor-pointer items-center" @click="expanded = !expanded">
    <button
      aria-label={`Toggle ${title}`}
      class="float-left mr-3 -ml-8 cursor-pointer transition-transform ease-in-out"
      :style="{ transform: expanded ? 'rotate(0deg)' : 'rotate(-90deg)' }"
    >
      <IoIosArrowDropdown />
    </button>
    <span class="[&>svg]:mr-2 [&>svg]:size-5"><slot name="icon" /></span>
    {title}
  </h3>

  <div x-cloak x-show="expanded" x-collapse x-transition>
    <slot />
  </div>
</div>

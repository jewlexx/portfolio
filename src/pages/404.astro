---
import Layout from "$/layouts/Layout.astro";
import ErrorTerminal from "$/components/404Terminal";

import * as cowsay from "cowsay";
const requestUrl = new URL(Astro.request.url);
const errorMessage = `Oops! "${requestUrl.pathname}" doesn't exist!!`;
const cowError = cowsay.say({
  text: errorMessage,
});
---

<Layout>
  <main>
    <ErrorTerminal
      client:load
      requestUrl={requestUrl}
      errorMessage={errorMessage}
      cowError={cowError}
    />
  </main>
</Layout>

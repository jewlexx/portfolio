---
import { sortProject } from "$/projects";

import ProjectsComponent from "$/components/Projects.astro";
import appendWinpax from "$/projects/winpax/projects_compat";
import Layout from "$/layouts/Layout.astro";
import { getCollection } from "astro:content";
import Head from "$/components/Head.astro";
import { appendRepertoire } from "$/projects/repertoire/compat";

const nextUrl = Astro.site;
const imageUrl = `${nextUrl}/icons/repertoire.png`;
const winpaxHero = `${nextUrl}/hero-images/winpax.png`;

const postsCollection = await getCollection("projects");
const posts = appendRepertoire(
  imageUrl,
  appendWinpax(
    winpaxHero,
    postsCollection.map((post) => ({
      ...post.data,
      slug: post.id,
      content: post.body!,
    })),
  ),
).sort(sortProject);
---

<Layout>
  <Head
    title="Projects"
    description="Juliette Cordor's collection of highlighted projects"
  />
  <main>
    <ProjectsComponent posts={posts} />
  </main>
</Layout>

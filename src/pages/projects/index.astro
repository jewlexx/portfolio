---
import { sortProject } from "$/projects";

import ProjectsComponent from "$/components/Projects.astro";
import appendWinpax from "$/projects/winpax/projects_compat";
import Layout from "$/layouts/Layout.astro";
import { getCollection } from "astro:content";
import Head from "$/components/Head.astro";
import { appendRepertoire } from "$/projects/repertoire/compat";
import FeaturedProject from "$/components/FeaturedProject.astro";
import Projects from "$/components/Projects.astro";

const nextUrl = Astro.site;
const imageUrl = `${nextUrl}/icons/repertoire.png`;
const winpaxHero = `${nextUrl}/hero-images/winpax.png`;

const projectsCollection = await getCollection("projects");
const projects = appendRepertoire(
  imageUrl,
  appendWinpax(
    winpaxHero,
    projectsCollection.map((project) => ({
      ...project.data,
      slug: project.id,
      content: project.body!,
    })),
  ),
).sort(sortProject);

const featuredProject = projects.find((project) => project.featured);
const unfeaturedProjects = projects.filter((project) => !project.featured);
---

<Layout>
  <Head
    title="Projects"
    description="Juliette Cordor's collection of highlighted projects"
  />
  <main>
    {featuredProject && <FeaturedProject project={featuredProject} />}
    <Projects projects={unfeaturedProjects} />
  </main>
</Layout>

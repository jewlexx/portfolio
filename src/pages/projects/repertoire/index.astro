---
import { IconBrandApple, IconBrandAndroid } from "@tabler/icons-react";
import IconLink from "$/components/IconLink.astro";
import repertoireIcon from "$/../public/icons/repertoire.png";
import productImages from "$/projects/repertoire/images";
import Project from "$/layouts/Project.astro";
import Head from "$/components/Head.astro";
import { Image } from "astro:assets";

const metadata = {
  title: "Repertoire",
  description: "A simple application for managing eScripts",
  openGraph: {
    type: "article",
    authors: ["Juliette Cordor"],
    images: {
      url: "/hero-images/repertoire.webp",
    },
  },
};
---

<Project>
  <Head
    title={metadata.title}
    description={metadata.description}
    ogImages={["/hero-images/repertoire.webp"]}
  />
  <div class="project-main">
    <div class="title">
      <span class="mb-4 flex gap-4">
        <Image
          class="m-0 p-0"
          loading="eager"
          src={repertoireIcon}
          alt="Repertoire Icon"
          width={64}
          height={64}
        />
        <h1 class="mb-0 self-center">{metadata.title}</h1>
      </span>
      <i class="text-sm">🇦🇺 Australia Only</i>
      <br />
      <i>{metadata.description}</i>
      <div class="date">
        {/* {pubDate && <PubDate pubDate={new Date(pubDate)} />} */}
        {
          /* {
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							} */
        }
      </div>
      <div
        class="flex flex-wrap justify-center gap-8 portrait:*:not-first:hidden"
      >
        {
          Object.entries(productImages).map(([key, image]) => {
            return (
              <Image
                src={image}
                alt={`${key} page`}
                height={384}
                class="h-96"
                loading="lazy"
              />
            );
          })
        }
      </div>

      {
        /* {shields && (
            <p class="flex flex-wrap justify-center gap-2">
              {shields?.map((shield) => (
                <Shield {...shield} key={shield.src} />
              ))}
            </p>
          )} */
      }

      <span class="linksContainer">
        <IconLink
          url="https://testflight.apple.com/join/gq97wtCk"
          icon={IconBrandApple}
          title="Download iOS Beta"
          class="btn-secondary"
        />
        <IconLink
          url="https://gitlab.com/cordor/repertoire/-/releases"
          icon={IconBrandAndroid}
          title="Download Android Beta"
          class="btn-secondary"
        />
        {
          /* {repo && (
              <IconLink
                url={repo}
                icon={IconBrandGit}
                title="Git Source"
                class="btn-secondary"
              />
            )}
            {homepage && (
              <IconLink
                url={homepage}
                icon={LinkIcon}
                title="Homepage"
                class="btn-secondary"
              />
            )}
            {download && (
              <IconLink
                url={githubRelease(repo) ?? "#"}
                title="Download"
                icon={IconDownload}
                class="btn-secondary"
              />
            )} */
        }
      </span>
      <hr />
      <p>
        Repertoire is a simplistic application to help users manage their
        eScripts.
      </p>
      <p>
        It provides a single list of all your scripts, along with pages
        dedicated to that medication.
      </p>
      <p>
        The app provides the script's QR code, ready to be scanned at any
        pharmacy that accepts eScripts, as well as relevant information like
        remaining repeats.
      </p>
      <p>
        If you would like to download the app, use one of the links above for
        iOS or Android, and please feel free to leave feedback directly from
        within the app.
      </p>
    </div>
  </div>
</Project>

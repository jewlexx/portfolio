---
import Header from "$/components/Header.astro";
import { knownTheme } from "$/theme";
import "../styles/global.css";
---

<html lang="en" data-theme={knownTheme.light}>
  <head>
    <meta charset="utf-8" />
  </head>
  <body
    class="min-h-screen grid-cols-[22rem_100fr] gap-4 *:max-h-screen *:overflow-auto lg:grid overflow-y-hidden"
  >
    <script src="$/scripts/scroll-listener.ts"></script>
    <Header />

    <div class="pt-4 pb-4" x-data="bodydata" @scroll="handleScroll">
      <slot />
    </div>
  </body>
</html>
